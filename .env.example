# ============================================================
# ShopFlow Environment Configuration Example
# Copy this file to .env or set environment variables in your deployment platform
# ============================================================

# Security Secrets (REQUIRED)
# Must be at least 256 bits (32+ characters)
JWT_SECRET=replace_with_a_long_random_secret_at_least_256_bits_length_for_hmac_sha256

# Database Configuration (Optional for production)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/shopflow
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# Firebase Admin Credentials (Optional)
# Option A: Path to Google Application Default Credentials
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccountKey.json

# Option B: Complete JSON string of service account key
# FIREBASE_CONFIG_JSON={"type":"service_account",...}
